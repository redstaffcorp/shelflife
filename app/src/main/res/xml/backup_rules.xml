<?xml version="1.0" encoding="utf-8"?>
<!--
   Automatikus biztonsagi mentes Android 11 (API 30) es korabbi rendszereken.
   (Android 12+ eseten a data_extraction_rules.xml ervenyes.)

   Tudatos dontes: a kamra tartalmat ENGEDJUK a felhasznalo SAJAT Google-fiokjanak
   rendszerszintu mentesebe kerulni, mert igy telefoncserenel / ujratelepitesnel
   nem vesz el a lista. Sajat szerverunk nincs, mi nem latjuk az adatokat.
   Az ertelmezes a szovegekben is ez: "nincs fiok, nincs sajat szerver",
   NEM az, hogy "semmi nem hagyja el a telefont".

   A Room WAL-modban fut, ezert a -wal es -shm fajlokat is mentjuk, kulonben
   a legutobbi irasok hianyozhatnanak a visszaallitott adatbazisbol.
-->
<full-backup-content>
    <include domain="database" path="shelflife.db" />
    <include domain="database" path="shelflife.db-wal" />
    <include domain="database" path="shelflife.db-shm" />
    <include domain="sharedpref" path="." />
</full-backup-content>
