<?xml version="1.0" encoding="utf-8"?>
<!--
   Biztonsagi mentes es eszkozok kozotti atvitel Android 12+ (API 31+) rendszeren.
   Ugyanaz a tartalom, mint a backup_rules.xml-ben (lasd ott az indoklast):
   a Room adatbazis + a beallitasok. A mentes a felhasznalo sajat
   Google-fiokjaba tortenik (vegponttol vegpontig titkositva, ha a telefonon
   van kepernyozar), sajat szerverunk nincs.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="shelflife.db" />
        <include domain="database" path="shelflife.db-wal" />
        <include domain="database" path="shelflife.db-shm" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="shelflife.db" />
        <include domain="database" path="shelflife.db-wal" />
        <include domain="database" path="shelflife.db-shm" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
