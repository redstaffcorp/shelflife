    <string name="onboarding_next">Tovább</string>
    <string name="onboarding_start">Kezdjük</string>
    <string name="onboarding_welcome_title">Ne dobj ki több ételt</string>
    <string name="onboarding_welcome_text">A ShelfLife figyeli, mi mikor jár le a hűtődben és a kamrádban – és időben szól. Regisztráció és saját szerver nélkül: a listádat mi nem látjuk. A telefonod biztonsági mentése megőrzi, így telefoncserénél sem vész el.</string>
    <string name="onboarding_scan_title">Beolvasás másodpercek alatt</string>
    <string name="onboarding_scan_text">Nyomd meg a „Termék beolvasása” gombot, mutasd a vonalkódot, majd tartsd a lejárati dátumot a keretbe. Ha a kamera nem boldogul vele: „~1 hét”, „Később” vagy írd be számokkal (pl. 2510 = okt. 25.). Kör elején válaszd ki: hűtő, fagyasztó vagy kamra.</string>
    <string name="onboarding_scan_sample_date">MINŐSÉGÉT MEGŐRZI: 25.10.2026</string>
    <string name="onboarding_quick_title">Vonalkód nélkül is</string>
    <string name="onboarding_quick_text">Kenyér, tojás, zöldség? A + gombbal egy koppintás. Ilyenkor a lejárat becsült (~ jel) – a listában bármikor pontosíthatod.</string>
    <string name="onboarding_quick_sample_status">~ 3 nap múlva jár le · becsült</string>
    <string name="onboarding_swipe_title">Elfogyott vagy kidobtad?</string>
    <string name="onboarding_swipe_text">Húzd a tételt balra, ha elfogyott, jobbra, ha ki kellett dobni. Több darabnál a „−1” gomb eggyel csökkenti a mennyiséget. Tévedtél? Lent a „Visszavonás” mindent visszacsinál.</string>
    <string name="onboarding_swipe_sample_name">Joghurt</string>
    <string name="onboarding_swipe_sample_status">2 nap múlva jár le · 4 darab</string>
    <string name="onboarding_swipe_legend_left">← balra: elfogyott</string>
    <string name="onboarding_swipe_legend_right">jobbra: kidobtam →</string>
    <string name="onboarding_notify_title">Szólunk, mielőtt lejár</string>
    <string name="onboarding_notify_text">Naponta egyszer ellenőrizzük a listát. Az értesítésből egy koppintással jelezheted, hogy elfogyott, vagy kérhetsz emlékeztetőt holnapra. Később a harang ikonnal állíthatod.</string>
    <string name="onboarding_notify_enable">Értesítések bekapcsolása</string>
    <string name="onboarding_notify_enabled">Értesítések bekapcsolva</string>

