    <!-- Einführung -->
    <string name="action_show_onboarding">Wie funktioniert es?</string>
    <string name="onboarding_skip">Überspringen</string>
    <string name="onboarding_next">Weiter</string>
    <string name="onboarding_start">Los geht’s</string>
    <string name="onboarding_welcome_title">Nie mehr Essen wegwerfen</string>
    <string name="onboarding_welcome_text">ShelfLife behält im Blick, was in Kühlschrank und Vorratsschrank wann abläuft – und erinnert dich rechtzeitig. Ohne Registrierung und ohne eigene Server: Wir sehen deine Liste nie. Das Backup deines Handys bewahrt sie auf, damit sie beim Handywechsel nicht verloren geht.</string>
    <string name="onboarding_scan_title">In Sekunden erfasst</string>
    <string name="onboarding_scan_text">Tippe auf „Produkte scannen“, zeige den Barcode und halte dann das Haltbarkeitsdatum in den Rahmen. Wenn die Kamera es nicht lesen kann: „~1 Woche“, „Später“ oder als Ziffern eingeben (z. B. 2510 = 25. Okt.). Wähle zu Beginn: Kühlschrank, Gefrierfach oder Vorratsschrank.</string>
    <string name="onboarding_scan_sample_date">MINDESTENS HALTBAR BIS: 25.10.2026</string>
    <string name="onboarding_quick_title">Auch ohne Barcode</string>
    <string name="onboarding_quick_text">Brot, Eier, Gemüse? Ein Tipp auf die +-Taste. Das Ablaufdatum ist dann geschätzt (~-Zeichen) – du kannst es jederzeit in der Liste korrigieren.</string>
    <string name="onboarding_quick_sample_status">~ Läuft in 3 Tagen ab · geschätzt</string>
    <string name="onboarding_swipe_title">Aufgebraucht oder weggeworfen?</string>
    <string name="onboarding_swipe_text">Wische einen Artikel nach links, wenn er aufgebraucht ist, nach rechts, wenn du ihn wegwerfen musstest. Bei mehreren Stück verringert „−1“ die Menge um eins. Vertan? „Rückgängig“ unten macht alles wieder rückgängig.</string>
    <string name="onboarding_swipe_sample_name">Joghurt</string>
    <string name="onboarding_swipe_sample_status">Läuft in 2 Tagen ab · 4 Stück</string>
    <string name="onboarding_swipe_legend_left">← links: aufgebraucht</string>
    <string name="onboarding_swipe_legend_right">rechts: weggeworfen →</string>
    <string name="onboarding_notify_title">Wir erinnern dich vor dem Ablauf</string>
    <string name="onboarding_notify_text">Wir prüfen die Liste einmal täglich. In der Benachrichtigung kannst du mit einem Tipp „aufgebraucht“ melden oder dich morgen erneut erinnern lassen. Später kannst du das über das Glockensymbol ändern.</string>
    <string name="onboarding_notify_enable">Benachrichtigungen einschalten</string>
    <string name="onboarding_notify_enabled">Benachrichtigungen sind an</string>

