    <!-- Présentation -->
    <string name="action_show_onboarding">Comment ça marche ?</string>
    <string name="onboarding_skip">Passer</string>
    <string name="onboarding_next">Suivant</string>
    <string name="onboarding_start">C’est parti</string>
    <string name="onboarding_welcome_title">Ne jette plus de nourriture</string>
    <string name="onboarding_welcome_text">ShelfLife suit ce qui périme et quand, dans ton frigo et ton placard – et te prévient à temps. Sans inscription et sans serveur à nous : nous ne voyons jamais ta liste. La sauvegarde de ton téléphone la conserve, pour ne pas la perdre en changeant de téléphone.</string>
    <string name="onboarding_scan_title">Enregistré en quelques secondes</string>
    <string name="onboarding_scan_text">Appuie sur « Scanner des produits », montre le code-barres, puis place la date de péremption dans le cadre. Si la caméra n’y arrive pas : « ~1 semaine », « Plus tard », ou saisis-la en chiffres (ex. 2510 = 25 oct.). Au début, choisis : frigo, congélateur ou placard.</string>
    <string name="onboarding_scan_sample_date">À CONSOMMER DE PRÉFÉRENCE AVANT : 25.10.2026</string>
    <string name="onboarding_quick_title">Même sans code-barres</string>
    <string name="onboarding_quick_text">Pain, œufs, légumes ? Une touche sur le bouton +. La péremption est alors estimée (signe ~) – tu peux la corriger dans la liste à tout moment.</string>
    <string name="onboarding_quick_sample_status">~ Périme dans 3 jours · estimée</string>
    <string name="onboarding_swipe_title">Consommé ou jeté ?</string>
    <string name="onboarding_swipe_text">Fais glisser un article vers la gauche s’il est consommé, vers la droite s’il a fallu le jeter. Pour plusieurs pièces, « −1 » diminue la quantité d’une unité. Une erreur ? « Annuler » en bas remet tout en place.</string>
    <string name="onboarding_swipe_sample_name">Yaourt</string>
    <string name="onboarding_swipe_sample_status">Périme dans 2 jours · 4 pièces</string>
    <string name="onboarding_swipe_legend_left">← gauche : consommé</string>
    <string name="onboarding_swipe_legend_right">droite : jeté →</string>
    <string name="onboarding_notify_title">On te prévient avant la péremption</string>
    <string name="onboarding_notify_text">Nous vérifions la liste une fois par jour. Depuis la notification, tu peux indiquer en une touche que c’est consommé, ou demander un rappel pour demain. Tu pourras modifier cela plus tard avec l’icône de cloche.</string>
    <string name="onboarding_notify_enable">Activer les notifications</string>
    <string name="onboarding_notify_enabled">Notifications activées</string>

